import { len } from strings::std;

// fixture_miduse: `len` is used BETWEEN two import statements. A reader that
// only looks after the LAST import calls it unused; the name is used.
let size <int> = len("mid");

import { printf } from stdio::std;

fun main() <noret> {
    printf("%d\n", size);
}
