// linf.fin — the linf v0 binary. See ../RFC.md for the rulings this implements.
//
// THE ARCHITECTURE (RFC §1, non-negotiable): finc is the source of truth. For
// every path linf runs
//
//     finc <path> --diagnostics=json --color=never
//
// and parses the contract's JSONL off stderr. The capture merges `2>&1` into
// the read pipe (process.fin's exec_command captures stdout): sound only
// because finc's stdout is contract-silent for every non-reserved flag, which
// is exactly what this invocation uses.
//
// Output (RFC §3): the contract shape by default; `--format gcc` one-liners
// (VS Code `problemMatcher: "$gcc"`, Neovim errorformat); `--format actions`
// workflow annotations; `--format sarif` 2.1.0 (code scanning, SARIF viewers).
// Line/SARIF renderings come from bounded top-level JSON fields; the contract
// format forwards valid finc records VERBATIM, including unknown kinds.
// Malformed records fail as plumbing without contaminating the output JSONL.
//
// Exit codes (RFC §3): 0 clean, 1 findings (or sources finc rejected, passed
// through), 2 usage/IO/plumbing (including a missing summary), 3 propagate a
// finc failure. linf's own failures are emitted as contract JSONL too.
//
// Findings grow geometrically to 65536; the ceiling has a reserved plumbing
// diagnostic outside the pool. Import tracking is bounded by the token count.

import { read_to_string, free_file_content } from fs::std;
import { ProcessResult, exec_command, free_process_result } from process::std;
import { Command, Match, Outcome, free_match } from cli::std;
import { CdkTokens, cdk_scan, free_cdk_tokens } from cdk::std;
import { tok_ident, tok_semicolon, tok_lbracket, tok_rbracket, tok_rparen,
      tok_lbrace, tok_rbrace, tok_comma, tok_dot, tok_double_colon, kw_as,
      tok_int_lit, tok_float_lit, tok_string_lit, tok_char_lit,
      kw_import, kw_from, kw_new, kw_delete, kw_blame } from token::std;
import { Buffer, new_buffer, free_buffer } from buffer::std;
import { len, to_chars, from_chars, equals, concat, clone, free_str } from strings::std;
import { json_decode_str } from json::std;
import { cli_dprintf } from cli::std;

// A finding in the contract's field set, renderer-agnostic: linf-owned
// findings carry `code` ("linf:<rule>"); finc-sourced ones do not, because
// the contract's `code` is null for finc diagnostics today.
priv struct Fnd {
    pub sev <int> = 1, // 0 note 1 warning 2 error (diag.fin's levels)
    pub code <string> = "",
    pub message <string> = "",
    pub file <string> = "",
    pub line <int> = 1,
    pub col <int> = 1,
}

// A reserved diagnostic is independent of the heap pool, so a deliberate
// resource ceiling cannot silently swallow a plumbing failure. Fin's `new`
// has no recoverable OOM path; allocation failure remains a runtime limit.
priv struct Run {
    pub fnds <[Fnd]>,
    pub capacity <int> = 256,
    pub count <int> = 0,
    pub exhausted <bool> = false,
    pub emergency <Fnd> = Fnd{sev: 2, code: "linf:plumbing",
          message: "diagnostic limit (65536) reached; findings are incomplete", file: "", line: 0, col: 0},
    pub linf_count <int> = 0,
    pub linf_errors <int> = 0,
    pub finc_errors <int> = 0,
    pub finc_warnings <int> = 0,
    pub linf_exit <int> = 0,

    pub static fun create() <Run> {
        let pool <[Fnd]> = new [Fnd, 256]{};
        return Run{fnds: pool};
    }

    pub fun allocation_failed(self: &Self) <noret> {
        if (!self.exhausted) {
            self.exhausted = true;
            self.linf_count++;
            self.linf_errors++;
        }
        self.worsen(2);
    }

    pub fun add(self: &Self, sev: int, code: string, message: string,
                file: string, line: int, col: int) <noret> {
        if (self.exhausted) { return; }
        if (self.count == self.capacity) {
            if (self.capacity >= 65536) { self.allocation_failed(); return; }
            let cap <int> = self.capacity * 2;
            let pool <[Fnd]> = new [Fnd, cap]{};
            for (let i <int> = 0; i < self.count; i++) { pool[i] = self.fnds[i]; }
            delete self.fnds;
            self.fnds = pool;
            self.capacity = cap;
        }
        let f <Fnd> = Fnd{sev: sev,
              code: clone(code), message: clone(message), file: clone(file),
              line: line, col: col};
        self.fnds[self.count] = f;
        self.count++;
        if (!equals(code, "")) {
            self.linf_count++;
            if (sev >= 2) { self.linf_errors++; }
        }
    }

    pub fun size(self: &Self) <int> {
        if (self.exhausted) { return self.count + 1; }
        return self.count;
    }

    pub fun at(self: &Self, i: int) <&Fnd> {
        if (i == self.count) { return &self.emergency; }
        return &self.fnds[i];
    }

    // Compiler failure outranks plumbing; source rejection never hides either.
    pub fun worsen(self: &Self, code: int) <noret> {
        if (code <= 0) { return; }
        let rank <int> = code;
        if (rank > 3) { rank = 2; }
        if (rank > self.linf_exit) { self.linf_exit = rank; }
    }
}

// Contract severity word for a mapped level; unknown still spells "error"
// per the contract's unknown-severity rule.
priv fun sev_word(sev: int) <string> {
    if (sev == 0) { return "note"; }
    if (sev == 1) { return "warning"; }
    return "error";
}

// Severity map from a JSONL severity spelling; levels follow diag.fin
// (0 note 1 warning else error).
priv fun sev_map(sev_text: string) <int> {
    if (equals(sev_text, "note")) { return 0; }
    if (equals(sev_text, "warning")) { return 1; }
    return 2;
}

// ---- bounded JSON records -------------------------------------------------
// This reads JSON, not Fin source. Unknown fields are structurally skipped;
// only top-level contract fields are interpreted. Every cursor stays inside
// one line, so earlier diagnostics and nested keys cannot shadow this record.
priv struct JsonRecord {
    pub bytes <[char]>,
    pub pos <int> = 0,
    pub end <int> = 0,
    pub valid <bool> = true,

    pub fun ws(self: &Self) <noret> {
        while (self.pos < self.end) {
            let c <char> = self.bytes[self.pos];
            if (c != ' ' && c != '\t' && c != '\r') { break; }
            self.pos++;
        }
    }

    pub fun take(self: &Self, c: char) <bool> {
        self.ws();
        if (self.pos >= self.end || self.bytes[self.pos] != c) { return false; }
        self.pos++;
        return true;
    }

    pub fun hex4(self: &Self) <int> {
        let v <int> = 0;
        for (let j <int> = 0; j < 4; j++) {
            if (self.pos >= self.end) { self.valid = false; return 0; }
            let c <char> = self.bytes[self.pos];
            self.pos++;
            let h <int> = -1;
            if (c >= '0' && c <= '9') { h = c - '0'; }
            if (c >= 'a' && c <= 'f') { h = c - 'a' + 10; }
            if (c >= 'A' && c <= 'F') { h = c - 'A' + 10; }
            if (h < 0) { self.valid = false; return 0; }
            v = v * 16 + h;
        }
        return v;
    }

    // Decode once, including Unicode escapes (the SDK scalar decoder only
    // accepts ASCII). NUL cannot be represented in Fin's C strings: refuse it
    // explicitly rather than silently truncate a message, key or path.
    pub fun string_value(self: &Self) <string> {
        if (!self.take('"')) { self.valid = false; return clone(""); }
        let out <Buffer> = new_buffer(32);
        let closed <bool> = false;
        while (self.pos < self.end && self.valid) {
            let c <char> = self.bytes[self.pos];
            self.pos++;
            if (c == '"') { closed = true; break; }
            if (cast<int>(c) >= 0 && cast<int>(c) < 32) { self.valid = false; break; }
            if (c != '\\') { out.write_char(c); continue; }
            if (self.pos >= self.end) { self.valid = false; break; }
            let e <char> = self.bytes[self.pos];
            self.pos++;
            if (e == '"' || e == '\\' || e == '/') { out.write_char(e); }
            else if (e == 'n') { out.write_char('\n'); }
            else if (e == 'r') { out.write_char('\r'); }
            else if (e == 't') { out.write_char('\t'); }
            else if (e == 'b') { out.write_char(cast<char>(8)); }
            else if (e == 'f') { out.write_char(cast<char>(12)); }
            else if (e == 'u') {
                let cp <int> = self.hex4();
                if (cp >= 55296 && cp <= 56319) {
                    if (self.pos + 2 > self.end || self.bytes[self.pos] != '\\'
                        || self.bytes[self.pos + 1] != 'u') { self.valid = false; break; }
                    self.pos += 2;
                    let low <int> = self.hex4();
                    if (low < 56320 || low > 57343) { self.valid = false; break; }
                    cp = 65536 + (cp - 55296) * 1024 + low - 56320;
                } else if (cp >= 56320 && cp <= 57343) { self.valid = false; break; }
                if (cp == 0) { self.valid = false; break; }
                if (cp < 128) { out.write_char(cast<char>(cp)); }
                else if (cp < 2048) {
                    out.write_char(cast<char>(192 + cp / 64));
                    out.write_char(cast<char>(128 + cp % 64));
                } else if (cp < 65536) {
                    out.write_char(cast<char>(224 + cp / 4096));
                    out.write_char(cast<char>(128 + cp / 64 % 64));
                    out.write_char(cast<char>(128 + cp % 64));
                } else {
                    out.write_char(cast<char>(240 + cp / 262144));
                    out.write_char(cast<char>(128 + cp / 4096 % 64));
                    out.write_char(cast<char>(128 + cp / 64 % 64));
                    out.write_char(cast<char>(128 + cp % 64));
                }
            } else { self.valid = false; }
        }
        if (!closed) { self.valid = false; }
        let result <string> = out.to_string();
        free_buffer(out);
        return result;
    }

    pub fun literal(self: &Self, word: string) <bool> {
        let chars <[char]> = to_chars(word);
        let n <int> = len(word);
        let ok <bool> = self.pos + n <= self.end;
        for (let i <int> = 0; i < n && ok; i++) {
            if (self.bytes[self.pos + i] != chars[i]) { ok = false; }
        }
        delete chars;
        if (ok) { self.pos += n; }
        return ok;
    }

    pub fun value(self: &Self, depth: int) <bool> {
        self.ws();
        if (depth > 128 || self.pos >= self.end) { return false; }
        let c <char> = self.bytes[self.pos];
        if (c == '"') {
            let s <string> = self.string_value();
            free_str(s);
            return self.valid;
        }
        if (c == '{' || c == '[') {
            self.pos++;
            let close <char> = ']';
            if (c == '{') { close = '}'; }
            if (self.take(close)) { return true; }
            while (self.pos < self.end) {
                if (c == '{') {
                    let key <string> = self.string_value();
                    free_str(key);
                    if (!self.valid || !self.take(':')) { return false; }
                }
                if (!self.value(depth + 1)) { return false; }
                if (self.take(close)) { return true; }
                if (!self.take(',')) { return false; }
            }
            return false;
        }
        if (c == 'n') { return self.literal("null"); }
        if (c == 't') { return self.literal("true"); }
        if (c == 'f') { return self.literal("false"); }
        if (c == '-') { self.pos++; }
        if (self.pos >= self.end) { return false; }
        c = self.bytes[self.pos];
        if (c < '0' || c > '9') { return false; }
        self.pos++;
        if (c != '0') {
            while (self.pos < self.end && self.bytes[self.pos] >= '0'
                   && self.bytes[self.pos] <= '9') { self.pos++; }
        }
        if (self.pos < self.end && self.bytes[self.pos] == '.') {
            self.pos++;
            let first <int> = self.pos;
            while (self.pos < self.end && self.bytes[self.pos] >= '0'
                   && self.bytes[self.pos] <= '9') { self.pos++; }
            if (first == self.pos) { return false; }
        }
        if (self.pos < self.end && (self.bytes[self.pos] == 'e' || self.bytes[self.pos] == 'E')) {
            self.pos++;
            if (self.pos < self.end && (self.bytes[self.pos] == '+' || self.bytes[self.pos] == '-')) {
                self.pos++;
            }
            let first <int> = self.pos;
            while (self.pos < self.end && self.bytes[self.pos] >= '0'
                   && self.bytes[self.pos] <= '9') { self.pos++; }
            if (first == self.pos) { return false; }
        }
        return true;
    }
}

priv fun field_id(key: string) <int> {
    if (equals(key, "kind")) { return 0; }
    if (equals(key, "severity")) { return 1; }
    if (equals(key, "message")) { return 2; }
    if (equals(key, "file")) { return 3; }
    if (equals(key, "line")) { return 4; }
    if (equals(key, "column")) { return 5; }
    if (equals(key, "errors")) { return 6; }
    if (equals(key, "warnings")) { return 7; }
    if (equals(key, "exitCode")) { return 8; }
    if (equals(key, "status")) { return 9; }
    return -1;
}

priv fun record_fields(rec: &JsonRecord, starts: [int], ends: [int]) <bool> {
    for (let i <int> = 0; i < 10; i++) { starts[i] = -1; }
    if (!rec.take('{')) { return false; }
    if (!rec.take('}')) {
        let closed <bool> = false;
        while (rec.pos < rec.end) {
            let key <string> = rec.string_value();
            let id <int> = field_id(key);
            free_str(key);
            if (!rec.valid || !rec.take(':')) { return false; }
            rec.ws();
            let start <int> = rec.pos;
            if (!rec.value(0)) { return false; }
            if (id >= 0) {
                if (starts[id] >= 0) { return false; }
                starts[id] = start;
                ends[id] = rec.pos;
            }
            if (rec.take('}')) { closed = true; break; }
            if (!rec.take(',')) { return false; }
        }
        if (!closed) { return false; }
    }
    rec.ws();
    return rec.valid && rec.pos == rec.end && starts[0] >= 0;
}

priv fun field_string(rec: &JsonRecord, start: int, end: int, nullable: bool) <string> {
    if (start < 0) { rec.valid = false; return clone(""); }
    let part <JsonRecord> = JsonRecord{bytes: rec.bytes, pos: start, end: end};
    if (nullable && part.literal("null")) { return clone(""); }
    let result <string> = part.string_value();
    if (!part.valid) { rec.valid = false; }
    return result;
}

priv fun field_int(rec: &JsonRecord, start: int, end: int) <int> {
    if (start < 0) { rec.valid = false; return 0; }
    let n <long> = cast<long>(0);
    for (let i <int> = start; i < end; i++) {
        let c <char> = rec.bytes[i];
        if (c < '0' || c > '9') { rec.valid = false; return 0; }
        n = n * cast<long>(10) + cast<long>(c - '0');
        if (n > cast<long>(2147483647)) { rec.valid = false; return 0; }
    }
    return cast<int>(n);
}

// One invocation, one valid trailing summary. Invalid records never leak raw
// text into JSONL output. Valid unknown kinds do, byte-for-byte.
priv fun chew_bytes(run: &Run, b: [char], end: int, contract_mode: int, path: string) <bool> {
    let starts <[int]> = new [int, 10]{};
    let ends <[int]> = new [int, 10]{};
    let start <int> = 0;
    let summaries <int> = 0;
    let broken <bool> = false;
    let errors <int> = 0;
    let warnings <int> = 0;
    let summary_errors <int> = 0;
    let summary_warnings <int> = 0;
    let summary_code <int> = 0;
    while (start < end) {
        let e <int> = start;
        while (e < end && b[e] != '\n') { e++; }
        if (summaries > 0) { broken = true; }
        let rec <JsonRecord> = JsonRecord{bytes: b, pos: start, end: e};
        if (!record_fields(&rec, starts, ends)) {
            broken = true;
            start = e + 1;
            continue;
        }
        let kind <string> = field_string(&rec, starts[0], ends[0], false);
        if (equals(kind, "summary")) {
            summaries++;
            summary_errors = field_int(&rec, starts[6], ends[6]);
            summary_warnings = field_int(&rec, starts[7], ends[7]);
            summary_code = field_int(&rec, starts[8], ends[8]);
            let status <string> = field_string(&rec, starts[9], ends[9], false);
            if (summary_code > 3 || (summary_code == 0 && !equals(status, "ok"))
                || (summary_code != 0 && !equals(status, "failed"))) { rec.valid = false; }
            free_str(status);
        } else if (equals(kind, "diagnostic")) {
            let sev <string> = field_string(&rec, starts[1], ends[1], false);
            let msg <string> = field_string(&rec, starts[2], ends[2], false);
            let file <string> = field_string(&rec, starts[3], ends[3], true);
            let ln <int> = field_int(&rec, starts[4], ends[4]);
            let col <int> = field_int(&rec, starts[5], ends[5]);
            if (rec.valid) {
                let level <int> = sev_map(sev);
                if (level == 2) { errors++; }
                if (level == 1) { warnings++; }
                if (contract_mode == 0) { run.add(level, "", msg, file, ln, col); }
                if (level > 0) { run.worsen(1); }
            }
            free_str(sev);
            free_str(msg);
            free_str(file);
        }
        if (!rec.valid) { broken = true; }
        else if (contract_mode != 0 && !equals(kind, "summary")) {
            let raw <string> = from_chars(b, start, e - start);
            cli_dprintf(2, "%s\n", raw);
            free_str(raw);
        }
        free_str(kind);
        start = e + 1;
    }
    delete starts;
    delete ends;
    let complete <bool> = !broken && summaries == 1;
    if (complete) {
        if (summary_errors > errors) { errors = summary_errors; }
        if (summary_warnings > warnings) { warnings = summary_warnings; }
        run.worsen(summary_code);
    } else {
        run.add(2, "linf:plumbing", "finc did not produce exactly one valid trailing summary", path, 0, 0);
        run.worsen(2);
    }
    run.finc_errors += errors;
    run.finc_warnings += warnings;
    return complete;
}

// POSIX shell words, not shell fragments. argv and Fin strings are already
// NUL-terminated: embedded NUL cannot be supplied as a command-line argument.
priv fun shell_word(text: string) <string> {
    let out <Buffer> = new_buffer(32);
    let chars <[char]> = to_chars(text);
    out.write_char('\'');
    for (let i <int> = 0; i < len(text); i++) {
        if (chars[i] == '\'') { out.write_string("'\\''"); }
        else { out.write_char(chars[i]); }
    }
    out.write_char('\'');
    delete chars;
    let result <string> = out.to_string();
    free_buffer(out);
    return result;
}

// ---- the three token rules, proven in fin-sdk's linf_first_rules.fin -------

priv fun import_stem(source: string) <string> {
    let chars <[char]> = to_chars(source);
    let begin <int> = 0;
    let end <int> = len(source);
    let dot <int> = -1;
    for (let i <int> = 0; i < end; i++) {
        if (chars[i] == '/') { begin = i + 1; dot = -1; }
        else if (chars[i] == '.') { dot = i; }
    }
    if (dot > begin) { end = dot; }
    let result <string> = from_chars(chars, begin, end - begin);
    delete chars;
    return result;
}

priv fun lint_imports(run: &Run, path: string, l: CdkTokens) <noret> {
    // At most one binding per token. Declarations are excluded from usage
    // scans, so a later import cannot make an earlier unused name look used.
    let names <[string]> = new [string, l.count]{};
    let positions <[int]> = new [int, l.count]{};
    let boundaries <[int]> = new [int, l.count]{};
    let declarations <[int]> = new [int, l.count]{};
    let count <int> = 0;
    let i <int> = 0;
    while (i < l.count) {
        if (l.tokens[i].kind != kw_import()) { i++; continue; }
        let end <int> = i + 1;
        while (end < l.count && l.tokens[end].kind != tok_semicolon()) { end++; }
        if (end == l.count) { break; } // finc owns malformed declarations
        for (let j <int> = i; j <= end; j++) { declarations[j] = end + 1; }
        let first <int> = count;
        let j <int> = i + 1;
        if (j < end && l.tokens[j].kind == tok_lbrace()) {
            j++;
            while (j < end && l.tokens[j].kind != tok_rbrace()) {
                if (l.tokens[j].kind == tok_ident()) {
                    let name <string> = clone(l.tokens[j].text);
                    names[count] = name;
                    positions[count] = j;
                    count++;
                }
                j++;
            }
        } else if (j < end && (l.tokens[j].kind == tok_ident()
                   || l.tokens[j].kind == tok_string_lit())) {
            let binding <string> = "";
            let pos <int> = j;
            let alias <int> = j;
            while (alias < end && l.tokens[alias].kind != kw_as()) { alias++; }
            if (alias + 1 < end && l.tokens[alias + 1].kind == tok_ident()) {
                pos = alias + 1;
                binding = clone(l.tokens[pos].text);
            } else if (l.tokens[j].kind == tok_string_lit()) {
                let decoded <Outcome<string>> = json_decode_str(l.tokens[j].text);
                if (decoded.is_ok()) {
                    binding = import_stem(decoded.value);
                    free_str(decoded.value);
                }
            } else {
                let module <Buffer> = new_buffer(32);
                while (j < end && (l.tokens[j].kind == tok_ident() || l.tokens[j].kind == tok_dot())) {
                    module.write_string(l.tokens[j].text);
                    j++;
                }
                let source <string> = module.to_string();
                free_buffer(module);
                binding = import_stem(source);
                free_str(source);
            }
            if (!equals(binding, "")) {
                names[count] = binding;
                positions[count] = pos;
                count++;
            }
        }
        // Wildcard imports introduce an unknown set of bindings: no guesses.
        for (let n <int> = first; n < count; n++) { boundaries[n] = end + 1; }
        i = end + 1;
    }
    for (let n <int> = 0; n < count; n++) {
        let used <bool> = false;
        let j <int> = boundaries[n];
        while (j < l.count) {
            if (declarations[j] != 0) { j = declarations[j]; continue; }
            if (l.tokens[j].kind == tok_ident() && equals(names[n], l.tokens[j].text)) {
                used = true;
                break;
            }
            j++;
        }
        if (!used) {
            let head <string> = concat("import '", names[n]);
            let msg <string> = concat(head, "' is never used in this file");
            run.add(1, "linf:unused-import", msg, path, l.tokens[positions[n]].line, 1);
            free_str(head);
            free_str(msg);
        }
        free_str(names[n]);
    }
    delete names;
    delete positions;
    delete boundaries;
    delete declarations;
}

priv fun lint_source(run: &Run, path: string, text: string) <noret> {
    // Rule 1: line length (first long line per file, v0 per RFC §4).
    let chars <[char]> = to_chars(text);
    let total <int> = len(text);
    let i <int> = 0;
    let lineno <int> = 1;
    let width <int> = 0;
    let longline <int> = 0;
    while (i < total) {
        let c <char> = chars[i];
        if (c == '\n') {
            if (width > 100 && longline == 0) {
                longline = lineno;
            }
            width = 0;
            lineno = lineno + 1;
        } else {
            width = width + 1;
        }
        i = i + 1;
    }
    if (width > 100 && longline == 0) { longline = lineno; }
    delete chars;
    if (longline != 0) {
        run.add(1, "linf:line-length", "line is longer than 100 columns",
              path, longline, 1);
    }

    // Rules 2 + 3: one token pass (delete-without-new and unused-import).
    let l <CdkTokens> = cdk_scan(text);
    let has_delete <int> = 0;
    let has_new <int> = 0;
    let first_delete_line <int> = 0;
    let first_index_line <int> = 0;
    let has_blame <int> = 0;
    let j <int> = 0;
    while (j < l.count) {
        let k <int> = l.tokens[j].kind;
        if (k == kw_delete() && has_delete == 0) {
            has_delete = 1;
            first_delete_line = l.tokens[j].line;
        }
        if (k == kw_new()) { has_new = 1; }
        if (k == kw_blame()) { has_blame = 1; }
        // Rule 4 (v0 file-level per RFC §4): a POSTFIX bracket — the index
        // operation `expr[...]`, never the type/`new` bracket spellings — in
        // a file that carries no `blame` at all.
        if (k == tok_lbracket() && j > 0 && first_index_line == 0) {
            let prev <int> = l.tokens[j - 1].kind;
            if (prev == tok_ident() || prev == tok_rparen()
                || prev == tok_rbracket() || prev == tok_int_lit()
                || prev == tok_float_lit() || prev == tok_string_lit()
                || prev == tok_char_lit()) {
                first_index_line = l.tokens[j].line;
            }
        }
        j = j + 1;
    }

    if (has_delete == 1 && has_new == 0) {
        run.add(1, "linf:delete-without-new", "delete with no new in this file",
              path, first_delete_line, 1);
    }
    if (first_index_line != 0 && has_blame == 0) {
        run.add(1, "linf:unchecked-index", "indexing without blame in this file",
              path, first_index_line, 1);
    }

    lint_imports(run, path, l);

    free_cdk_tokens(l);
}

// ---- renderers --------------------------------------------------------------

// Frozen json::std treats signed UTF-8 bytes as controls. Preserve those bytes
// here while escaping the actual JSON controls; never generate invalid hex.
priv fun json_encode_str(text: string) <string> {
    let chars <[char]> = to_chars(text);
    let hex <[char]> = to_chars("0123456789abcdef");
    let out <Buffer> = new_buffer(32);
    out.write_char('"');
    for (let i <int> = 0; i < len(text); i++) {
        let c <char> = chars[i];
        let byte <int> = cast<int>(c);
        if (byte < 0) { byte += 256; }
        if (c == '"') { out.write_string("\\\""); }
        else if (c == '\\') { out.write_string("\\\\"); }
        else if (byte < 32) {
            out.write_string("\\u00");
            out.write_char(hex[byte / 16]);
            out.write_char(hex[byte % 16]);
        } else { out.write_char(c); }
    }
    out.write_char('"');
    delete chars;
    delete hex;
    let result <string> = out.to_string();
    free_buffer(out);
    return result;
}

priv fun write_contract_line(f: &Fnd) <noret> {
    let enc_msg <string> = json_encode_str(f.message);
    let enc_code <string> = "";
    if (equals(f.code, "")) {
        enc_code = "null";
    } else {
        enc_code = json_encode_str(f.code);
    }
    let enc_file <string> = "";
    if (equals(f.file, "")) {
        enc_file = "null";
    } else {
        enc_file = json_encode_str(f.file);
    }
    let enc_sev <string> = json_encode_str(sev_word(f.sev));
    cli_dprintf(2, "{\"kind\":\"diagnostic\",\"severity\":%s,\"code\":%s,\"message\":%s,\"file\":%s,\"line\":%d,\"column\":%d,\"endLine\":%d,\"endColumn\":%d,\"help\":null,\"attribution\":null}\n",
          enc_sev, enc_code, enc_msg, enc_file, f.line, f.col, f.line, f.col);
    free_str(enc_msg);
    if (!equals(f.code, "")) { free_str(enc_code); }
    if (!equals(f.file, "")) { free_str(enc_file); }
    free_str(enc_sev);
}

priv fun write_gcc_line(f: &Fnd) <noret> {
    if (equals(f.file, "")) {
        // Location-less diagnostics (finc flag refusals, linf plumbing) have
        // no gcc-matcher shape; keep them on stderr with the tool named.
        let tool <string> = "linf";
        if (equals(f.code, "")) { tool = "finc"; }
        cli_dprintf(2, "%s: %s: %s\n", tool, sev_word(f.sev), f.message);
    } else {
        cli_dprintf(2, "%s:%d:%d: %s: %s\n", f.file, f.line, f.col, sev_word(f.sev), f.message);
    }
}

priv fun write_actions_line(f: &Fnd) <noret> {
    // GitHub annotations know error/warning/notice: note maps to notice.
    let aword <string> = sev_word(f.sev);
    if (equals(aword, "note")) { aword = "notice"; }
    if (equals(f.file, "")) {
        cli_dprintf(2, "::%s ::%s\n", aword, f.message);
    } else {
        cli_dprintf(2, "::%s file=%s,line=%d,col=%d::%s\n", aword, f.file, f.line, f.col, f.message);
    }
}

priv fun write_sarif(run: &Run, version: string) <noret> {
    cli_dprintf(2, "{\"version\":\"2.1.0\",\"$schema\":\"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json\",\"runs\":[{\"tool\":{\"driver\":{\"name\":\"linf\",\"version\":\"%s\",\"informationUri\":\"https://github.com/M1778/Linf\",\"rules\":[{\"id\":\"linf:line-length\"},{\"id\":\"linf:unused-import\"},{\"id\":\"linf:delete-without-new\"},{\"id\":\"linf:unchecked-index\"},{\"id\":\"linf:fmt-drift\"}]}},\"results\":[", version);
    let first <int> = 1;
    let idx <int> = 0;
    while (idx < run.size()) {
        let f <Fnd> = *run.at(idx);
        if (first == 0) {
            cli_dprintf(2, ",");
        }
        first = 0;
        let enc_msg <string> = json_encode_str(f.message);
        if (equals(f.code, "")) {
            // finc-sourced: no ruleId (tool-agnostic result)
            cli_dprintf(2, "{\"level\":\"%s\",\"message\":{\"text\":%s}", sev_word(f.sev), enc_msg);
        } else {
            let enc_code <string> = json_encode_str(f.code);
            cli_dprintf(2, "{\"ruleId\":%s,\"level\":\"%s\",\"message\":{\"text\":%s}", enc_code, sev_word(f.sev), enc_msg);
            free_str(enc_code);
        }
        free_str(enc_msg);
        if (!equals(f.file, "")) {
            let enc_file <string> = json_encode_str(f.file);
            cli_dprintf(2, ",\"locations\":[{\"physicalLocation\":{\"artifactLocation\":{\"uri\":%s},\"region\":{\"startLine\":%d,\"startColumn\":%d}}}]", enc_file, f.line, f.col);
            free_str(enc_file);
        }
        cli_dprintf(2, "}");
        idx = idx + 1;
    }
    cli_dprintf(2, "]}]}\n");
}

// ---- main --------------------------------------------------------------------

fun main() <int> {
    let cmd <Command> = Command::create("linf",
          "linter for Fin - finc reports compiler errors, linf reports style warnings");
    cmd.add_arg("format", 'f', true, "contract",
          "contract|gcc|actions|sarif (output lane)");
    cmd.add_arg("finc", '-', true, "finc", "the finc binary to run");
    let check_sub <&Command> = Command::make_sub("check",
          "check path(s): linf check [options] <path>...");
    cmd.sub(check_sub);

    let parsed <Outcome<Match>> = cmd.parse_args();
    if (!parsed.is_ok()) {
        // cli.fin reported and carried the problem; surface it verbatim.
        // The Err's default value holds no arrays, so nothing frees here.
        cli_dprintf(2, "%s\n", parsed.message);
        return 2;
    }
    let m <Match> = parsed.value;

    let fmt <string> = m.get("format");
    let format_mode <int> = 0; // 0 contract 1 gcc 2 actions 3 sarif
    if (equals(fmt, "gcc")) {
        format_mode = 1;
    } else if (equals(fmt, "actions")) {
        format_mode = 2;
    } else if (equals(fmt, "sarif")) {
        format_mode = 3;
    } else if (!equals(fmt, "contract")) {
        let bad <string> = concat("linf: unknown --format '", fmt);
        cli_dprintf(2, "%s' (use contract|gcc|actions|sarif)\n", bad);
        free_str(bad);
        free_match(m);
        return 2;
    }

    let finc_bin <string> = m.get("finc");
    if (m.pos_count <= 0) {
        cli_dprintf(2, "linf: no paths given\n");
        free_match(m);
        return 2;
    }

    let run <Run> = Run::create();

    let pi <int> = 0;
    while (pi < m.pos_count) {
        let path <string> = m.pos[pi];

        // finc is the source of truth (RFC §1). The capture merges stderr
        // into the read pipe: finc's stdout is contract-silent here.
        let executable <string> = shell_word(finc_bin);
        let source <string> = shell_word(path);
        let base <string> = concat(executable, " ");
        let one <string> = concat(base, source);
        free_str(executable);
        free_str(source);
        free_str(base);
        let two <string> = concat(one, " --diagnostics=json --color=never 2>&1");
        free_str(one);
        let res <ProcessResult> = exec_command(two);
        free_str(two);

        if (res.exit_code == -1) {
            run.add(2, "linf:plumbing", "could not run the finc binary", path, 0, 0);
            run.worsen(2);
        } else {
            let raw_text <string> = res.output;
            let total <int> = len(raw_text);

            let contract <int> = 0;
            if (format_mode == 0) { contract = 1; }
            let usable <[char]> = to_chars(raw_text);
            let complete <bool> = chew_bytes(&run, usable, total, contract, path);
            delete usable;

            // A missing/broken summary is always plumbing, even when another
            // invocation completed. Preserve compiler-failure precedence.
            if (!complete) {
                let st <int> = res.exit_code;
                let high <int> = st / 256;
                let rem <int> = st - high * 256;
                if (rem != 0 || high == 3 || (high >= 128 && high <= 192)) {
                    run.worsen(3);
                }
            }

            // Rules require readable source. finc remains the only authority
            // on compilation; linter rules never manufacture compiler errors.
            let src? <string> = read_to_string(path);
            if (src != null) {
                lint_source(&run, path, src?);
                free_file_content(src);
            }
        }
        free_process_result(res);

        pi = pi + 1;
    }

    // Findings worsen the exit per the mirror: anything user-facing fires 1.
    if (run.count > 0 && run.linf_exit == 0) {
        run.linf_exit = 1;
    }

    if (format_mode == 0) {
        // linf-owned lines only; finc's own already streamed verbatim above.
        let i <int> = 0;
        while (i < run.size()) {
            let f <Fnd> = *run.at(i);
            if (!equals(f.code, "")) {
                write_contract_line(run.at(i));
            }
            i = i + 1;
        }
    } else if (format_mode == 1) {
        let i <int> = 0;
        while (i < run.size()) {
            write_gcc_line(run.at(i));
            i = i + 1;
        }
    } else if (format_mode == 2) {
        let i <int> = 0;
        while (i < run.size()) {
            write_actions_line(run.at(i));
            i = i + 1;
        }
    } else {
        write_sarif(&run, "3.0.0");
    }

    // Exactly one summary — except the SARIF lane, whose document is the
    // terminal artifact: SARIF consumers choke on a trailing JSONL line, so
    // the document itself closes the stream (RFC §3).
    let status <string> = "ok";
    if (run.linf_exit > 0) { status = "failed"; }
    if (format_mode != 3) {
        let total_warns <int> = run.finc_warnings + (run.linf_count - run.linf_errors);
        cli_dprintf(2, "{\"kind\":\"summary\",\"errors\":%d,\"warnings\":%d,\"exitCode\":%d,\"status\":\"%s\"}\n",
              run.finc_errors + run.linf_errors, total_warns, run.linf_exit, status);
    }

    // Ownership: every entry's strings were cloned at add time.
    let i <int> = 0;
    while (i < run.count) {
        let f <&Fnd> = run.at(i);
        free_str(f.code);
        free_str(f.message);
        free_str(f.file);
        i = i + 1;
    }
    delete run.fnds;
    free_match(m);

    return run.linf_exit;
}
